rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// Cloud Storage security rules — AirBuddy Aerospace WorkSpace
//
// This file did not exist before: the project had no storage.rules under source
// control and no `storage` entry in firebase.json, so whatever was configured
// in the Firebase console was the only thing standing in front of the bucket
// and nobody could review it in a diff.
//
// The app writes to exactly one prefix — roadmap attachments, uploaded by
// src/services/roadmapAttachmentService.js as:
//
//     roadmapAttachments/{nodeId}/{timestamp}_{safeName}
//
// Access model mirrors firestore.rules for the attachments subcollection:
//   Read:   anybody isEmailAllowed() lets into the app (company-wide
//           transparency, same as roadmap nodes)
//   Write:  same audience, capped at 10 MB per object to match the
//           `fileSize <= 10485760` check on the Firestore metadata document
//   Delete: same audience — the Firestore attachment document is the real
//           record, and its rule already restricts deletion to the uploader or
//           an admin.
//
// isEmailAllowed() is the same check as in firestore.rules, read across
// services with firestore.exists()/firestore.get(). This used to be just
// `request.auth != null`, which let ANY Google account that could authenticate
// against the project read, overwrite or delete roadmap attachments — including
// a suspended external collaborator. Cross-service reads need the Storage
// service agent to have Firestore read access: the first
// `firebase deploy --only storage` with these rules offers to grant it.
// ─────────────────────────────────────────────────────────────────────────────

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    // Same as isEmailAllowed() in firestore.rules — keep the two identical.
    // @airbuddy.in is trusted; anybody else needs allowed_emails/{email} not
    // suspended (status defaults to approved when absent).
    function isEmailAllowed() {
      let email = request.auth.token.email;
      let ref   = /databases/(default)/documents/allowed_emails/$(email);
      return isSignedIn() && email is string && (
        email.matches('.*@airbuddy\\.in')
        || (firestore.exists(ref) && firestore.get(ref).data.get('status', 'approved') == 'approved')
      );
    }

    function isUnderSizeLimit() {
      return request.resource.size <= 10 * 1024 * 1024;
    }

    // ── Roadmap attachments ─────────────────────────────────────────────────
    match /roadmapAttachments/{nodeId}/{fileName} {
      allow read:           if isEmailAllowed();
      allow create, update: if isEmailAllowed() && isUnderSizeLimit();
      allow delete:         if isEmailAllowed();
    }

    // Everything else in the bucket is closed. Add an explicit match block
    // above when a new upload path is introduced — do not widen this.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
